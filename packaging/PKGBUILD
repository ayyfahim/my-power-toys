# Maintainer: Ahmed Karim <karimisma6464@gmail.com>
pkgname=my-power-toys
pkgver=0.1.0
pkgrel=1
pkgdesc="System utilities for Linux inspired by Microsoft PowerToys"
arch=('x86_64')
url="https://github.com/pedrokarim/my-power-toys"
license=('GPL-3.0-only')
depends=('dbus' 'gcc-libs')
makedepends=('rust' 'cargo')
optdepends=(
    'tesseract: OCR text extraction'
    'wl-clipboard: clipboard operations on Wayland'
    'xdotool: keyboard simulation on X11'
    'xclip: clipboard operations on X11'
    'imagemagick: image dimension detection'
    'ffmpeg: media file preview'
    'poppler: PDF preview'
    'ddcutil: Power Display control of external monitors (DDC/CI)'
    'brightnessctl: Power Display laptop backlight control'
    'xorg-xrandr: Power Display software brightness on X11'
    'polkit: File Locksmith and Environment Variables admin actions (pkexec)'
    'wf-recorder: ZoomIt recording on Wayland'
    'grim: screen capture on Wayland'
)
install=my-power-toys.install
source=("${pkgname}-${pkgver}.tar.gz")
_binaries=(
    mpt-daemon mpt-ctl mpt-settings
    mpt-app-launcher mpt-bulk-rename mpt-color-picker mpt-command-not-found
    mpt-command-palette mpt-crop-and-lock mpt-environment-variables
    mpt-fancy-zones mpt-file-locksmith mpt-hosts-editor mpt-image-resizer
    mpt-new-plus mpt-paste-plain mpt-peek mpt-power-display mpt-quick-accent
    mpt-screen-ruler mpt-shortcut-guide mpt-text-extractor mpt-workspaces
    mpt-zoom-it
)
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    # Whole workspace with default features, so every module's GUI binary is built.
    cargo build --release --locked --workspace
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    local bin
    for bin in "${_binaries[@]}"; do
        install -Dm755 "target/release/${bin}" "${pkgdir}/usr/bin/${bin}"
    done

    # Key Manager: input group access to /dev/uinput
    install -Dm644 "crates/key-manager/assets/99-mpt-uinput.rules" \
        "${pkgdir}/usr/lib/udev/rules.d/99-mpt-uinput.rules"

    install -Dm644 "assets/my-power-toys.desktop" "${pkgdir}/usr/share/applications/my-power-toys.desktop"
    install -Dm644 "assets/my-power-toys-daemon.desktop" "${pkgdir}/usr/share/applications/my-power-toys-daemon.desktop"
    install -Dm644 "assets/my-power-toys.service" "${pkgdir}/usr/lib/systemd/user/my-power-toys.service"

    install -Dm644 "assets/icons/icon-48.png" "${pkgdir}/usr/share/icons/hicolor/48x48/apps/my-power-toys.png"
    install -Dm644 "assets/icons/icon-128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/my-power-toys.png"
    install -Dm644 "assets/icons/icon-256.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/my-power-toys.png"
}
